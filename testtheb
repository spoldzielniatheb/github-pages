<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oferta Marketingowa</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
        }
        header {
            background-color: #2e3b4e;
            color: white;
            padding: 20px;
            text-align: center;
        }
        section {
            padding: 50px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        h1, h2 {
            color: #333;
        }
        .packages {
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }
        .package {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 30px;
            width: 30%;
            text-align: center;
        }
        .package h3 {
            color: #2e3b4e;
        }
        .package ul {
            list-style-type: none;
            padding: 0;
        }
        .package ul li {
            padding: 10px 0;
        }
        .check {
            color: #28a745;
            font-size: 18px;
            margin-right: 10px;
        }
        .package .price {
            font-size: 24px;
            font-weight: bold;
            color: #2e3b4e;
            margin-top: 20px;
        }
        .button {
            background-color: #2e3b4e;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            text-decoration: none;
            margin-top: 20px;
            display: inline-block;
        }
        .button:hover {
            background-color: #4b6274;
        }
        .full-offer {
            text-align: center;
            margin-top: 40px;
        }
        .full-offer a {
            background-color: #17a2b8;
            color: white;
            padding: 15px 30px;
            text-decoration: none;
            border-radius: 5px;
        }
        .full-offer a:hover {
            background-color: #138496;
        }
    </style>
</head>
<body>
